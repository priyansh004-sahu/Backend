<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
     *{
      background-color: black;
      color: wheat;
     }
  </style>
</head>
<body>
     <h1>Hello this is EJS </h1>
     <!-- <p> <%= message %> </p> -->
      <% for(let i=0; i < 5; i++) { %>
         <p> Item <%= i + 1 %> </p>      
     <% } %>

     <% message.forEach(message => {  %>
       <h1> <%= message %> </h1>
    <% }) %>
   
     <% html.forEach(html => {  %>
        <%- html %> 
    <% }) %>
    

</body>
</html>